{% types {
    title?: "string",
    classes?: "string",
    modifiers?: "string",
    attr?: "iterable<string, mixed>"
} %}

{# Defaults #}
{% set title = title|default("") %}
{% set classes = classes|default(null) %}
{% set modifiers = modifiers|default("") %}
{% set attr = attr|default({}) %}

{# Computed #}
{% set element_classes = html_tokens("c-accordion", modifiers, classes) %}
{% set element_attrs = merge({ class: element_classes }, attr) %}

{# ---------------------------------------- #}
<c-accordion {{ attr(element_attrs) }}>
    <details class="c-accordion_details">
        <summary class="c-accordion_summary">
            <span class="c-accordion_label || c-heading -h3">{{ title }}</span>
            <span class="c-accordion_icon" aria-hidden="true">&darr;</span>
        </summary>
        <div class="c-accordion_content" data-accordion="content">
            {% block default %}

            {% endblock %}
        </div>
    </details>
</c-accordion>

{{ craft.vite.script("src/scripts/components/Accordion.ts") }}
