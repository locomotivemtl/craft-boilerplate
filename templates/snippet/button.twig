{% types {
    link?: "object",
    href?: "string",
    label?: "string",
    icon?: "string",
    target?: "?string",
    external?: "boolean",
    animated?: "boolean",
    classes?: "string",
    modifiers?: "string",
    attr?: "iterable<string, mixed>",
    label_attr?: "iterable<string, mixed>",
    icon_attr?: "iterable<string, mixed>"
} %}

{# Defaults #}
{% set link = link|default({}) %}
{% set href = href|default(link.href|default(null)) %}
{% set label = label|default(link.label|default(null)) %}
{% set icon = icon|default(link.icon|default(null)) %}
{% set target = target|default(link.target|default(null)) %}
{% set external = external ?? is_external_url(href) %}
{% set animated = animated ?? true %}
{% set classes = classes|default(null) %}
{% set modifiers = modifiers|default(null) %}
{% set attr = attr|default({}) %}
{% set label_attr = label_attr|default({}) %}
{% set icon_attr = icon_attr|default({}) %}

{# --- Computed --------------------------- #}
{% set tag = href ? "a" : "span" %}
{% set is_anchor = tag == "a" %}
{% set button_classes = html_tokens("c-button", modifiers, classes) %}
{% set button_attrs =
    merge(
        {
            class: button_classes,
            href: if(is_anchor, href),
            target: target is defined ? target : if(is_anchor and external, "_blank"),
            rel: if(is_anchor and external, "noopener noreferrer"),
            "data-load": if(is_anchor and external, "false")
        },
        attr
    )
%}

{# ---------------------------------------- #}

{% tag tag with button_attrs %}
    <div class="c-button_inner">
        {% if icon and animated %}
            {% if (icon|length) > 1 %}
                {% include "snippet/icon" with {
                    icon,
                    classes: "c-button_icon",
                    attr: merge({ "aria-hidden": "true" }, icon_attr)
                } only %}
            {% else %}
                <span class="c-button_icon" aria-hidden="true">{{ icon }}</span>
            {% endif %}
        {% endif %}

        <span class="c-button_label" {{ attr(label_attr) }}>{{ label|raw }}</span>

        {% if icon %}
            {% if (icon|length) > 1 %}
                {% include "snippet/icon" with {
                    icon,
                    classes: "c-button_icon",
                    attr: merge({ "aria-hidden": "true" }, icon_attr)
                } only %}
            {% else %}
                <span class="c-button_icon" aria-hidden="true">{{ icon }}</span>
            {% endif %}
        {% endif %}
    </div>
{% endtag %}
