{% types {
    image?: "object",
    src?: "string",
    alt?: "string",
    width?: "number",
    height?: "number",
    caption?: "string",
    transform?: "mixed",
    is_figure?: "boolean",
    is_lazy_load?: "boolean",
    attr?: "?iterable<string, mixed>",
    classes?: "?string",
    modifiers?: "?string",
    inner_classes?: "?string",
    img_classes?: "?string"
} %}

{# Transform image #}
{% if image is defined and transform is defined and transform %}
    {% set image = image.transform(transform) %}
{% endif %}

{# Defaults #}
{% set image = image|default({}) %}
{% set src = src|default(image.src|default(null)) %}
{% set alt = alt|default(image.alt|default(null)) %}
{% set width = width|default(image.width|default(null)) %}
{% set height = height|default(image.height|default(null)) %}
{% set caption = caption|default(image.caption|default(null)) %}
{% set is_svg = image.isSVG ?? false %}
{% set transform = transform|default(null) %}
{% set is_figure = is_figure ?? false %}
{% set is_lazy_load = is_lazy_load ?? not is_svg %}
{% set attr = attr|default({}) %}
{% set classes = classes|default(null) %}
{% set modifiers = modifiers|default(null) %}
{% set inner_classes = inner_classes|default(null) %}
{% set img_classes = img_classes|default(null) %}

{# Computed #}
{% set tag = is_figure ? "figure" : "div" %}
{% set container_classes =
    html_tokens("c-image", classes, modifiers, if(is_lazy_load, "-lazy-load"))
%}
{% set container_attrs = merge({ class: container_classes }, attr) %}
{% set inner_classes_computed = html_tokens("c-image_inner", inner_classes)|join(" ") %}
{% set img_classes_computed = html_tokens("c-image_img", img_classes)|join(" ") %}

{% set img_attrs = {
    class: img_classes_computed,
    src: src,
    alt: alt,
    width: width,
    height: height,
    loading: is_lazy_load ? "lazy" : "eager",
    onload: is_lazy_load
        ? "this.classList.add('is-loaded'); this.parentNode.parentNode.classList.add('is-loaded');"
        : ""
} %}

{# ---------------------------------------- #}
{% if src %}
    {% tag tag with container_attrs %}
        <div class="{{ inner_classes_computed }}">
            <img {{ attr(img_attrs) }} />
        </div>

        {% if caption %}
            {% if is_figure %}
                <figcaption class="c-image_description">
                    {{- caption|raw -}}
                </figcaption>
            {% else %}
                <div class="c-image_description">
                    <span>{{ caption|raw }}</span>
                </div>
            {% endif %}
        {% endif %}
    {% endtag %}
{% endif %}
