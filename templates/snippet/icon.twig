{% types {
    icon: "string",
    aria_label?: "?string",
    classes?: "?string",
    modifiers?: "?string",
    attr?: "?iterable<string, mixed>"
} %}

{# --- Defaults ------------------------- #}
{% set aria_label = aria_label|default("") %}
{% set classes = classes|default(null) %}
{% set modifiers = modifiers|default("") %}
{% set attr = attr|default({}) %}

{# --- Computed --------------------------- #}
{% set icon_classes = html_tokens("c-icon", modifiers, classes) %}
{% set icon_attrs = merge({ class: icon_classes }, attr) %}
{% set svg_classes = "svg-" ~ icon %}

{# ---------------------------------------- #}
<span {{ attr(icon_attrs) }}>
    {% if aria_label %}
        <span class="sr-only">{{ aria_label }}</span>
    {% endif %}

    <svg class="{{ svg_classes }}" focusable="false" aria-hidden="true">
        <use xlink:href="/dist/sprite.svg?v={{ "now"|date("U") }}#{{ icon }}"></use>
    </svg>
</span>
